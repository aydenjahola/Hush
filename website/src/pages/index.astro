---
import '../styles/theme.css';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';

const title = "Hush · Per-app volume control for your Mac's menu bar";
const description =
  'Hush is a free, open-source menu bar mixer for macOS 26. Give every app its own fader, mute button and level meter, with boost up to 200%.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(withBase('/'), Astro.site)} />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Respect a theme chosen with Starlight's toggle on the docs pages.
      try {
        const theme = localStorage.getItem('starlight-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <main id="main">
      <Hero />
      <FeatureGrid />
      <HowItWorks />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    padding-inline: max(1rem, env(safe-area-inset-left));
    background: var(--hush-bg);
    color: var(--hush-text);
    font-family: var(--hush-font);
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }
  main,
  .footer {
    max-width: 1040px;
    margin-inline: auto;
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    padding: 0.5rem 1rem;
    background: var(--hush-accent);
    color: var(--hush-on-accent);
    border-radius: 8px;
  }
</style>
